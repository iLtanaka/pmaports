From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Reidel <adrian@travitia.xyz>
Date: Fri, 10 Nov 2023 22:03:37 +0100
Subject: [PATCH] arm64: dts: qcom: sm8450: Add clock-names to mdss

Signed-off-by: Jens Reidel <adrian@travitia.xyz>
(cherry picked from commit 4531c9b51fafeac52b8fd24353e5ec9df4683876)
---
 arch/arm64/boot/dts/qcom/sm8450.dtsi | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8450.dtsi b/arch/arm64/boot/dts/qcom/sm8450.dtsi
index 18ab94de4a..ff1b8450e5 100644
--- a/arch/arm64/boot/dts/qcom/sm8450.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8450.dtsi
@@ -3349,6 +3349,10 @@ mdss: display-subsystem@ae00000 {
 				 <&gcc GCC_DISP_HF_AXI_CLK>,
 				 <&gcc GCC_DISP_SF_AXI_CLK>,
 				 <&dispcc DISP_CC_MDSS_MDP_CLK>;
+			clock-names = "iface_clk",
+			          "gcc_bus",
+			          "gcc_nrt_bus",
+			          "branch_clk";
 
 			interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-controller;
