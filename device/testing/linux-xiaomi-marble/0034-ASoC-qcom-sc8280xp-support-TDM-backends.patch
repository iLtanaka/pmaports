From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Sat, 3 Oct 2026 02:44:04 +0800
Subject: [PATCH] ASoC: qcom: sc8280xp: support TDM backends

Set up TDM backends with I2S style framing (2 x 32-bit slots) for smart
amplifiers, and enable optional tdm-vote/tdm-bclk clocks while a TDM
stream is open, for platforms whose TDM interface needs a HLOS vote.

---
 sound/soc/qcom/sc8280xp.c | 79 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 77 insertions(+), 2 deletions(-)

diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index a9974399f6..61d16e48f1 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -2,6 +2,7 @@
 // Copyright (c) 2022, Linaro Limited
 
 #include <dt-bindings/sound/qcom,q6afe.h>
+#include <linux/clk.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <sound/soc.h>
@@ -15,9 +16,16 @@
 #include "common.h"
 #include "sdw.h"
 
+#define SC8280XP_TDM_SLOTS		2
+#define SC8280XP_TDM_SLOT_WIDTH		32
+#define SC8280XP_TDM_BCLK_RATE		(48000 * SC8280XP_TDM_SLOTS * SC8280XP_TDM_SLOT_WIDTH)
+
 struct sc8280xp_snd_data {
 	bool stream_prepared[AFE_PORT_MAX];
 	struct snd_soc_card *card;
+	/* Optional, for boards whose TDM interface needs a HLOS clock vote */
+	struct clk *tdm_vote;
+	struct clk *tdm_bclk;
 	struct snd_soc_jack jack;
 	struct snd_soc_jack dp_jack[8];
 	bool jack_setup;
@@ -36,6 +44,21 @@ static int sc8280xp_snd_init(struct snd_soc_pcm_runtime *rtd)
 	case QUINARY_MI2S_RX...QUINARY_MI2S_TX:
 		snd_soc_dai_set_fmt(cpu_dai, SND_SOC_DAIFMT_BP_FP);
 		break;
+	case PRIMARY_TDM_RX_0...QUINARY_TDM_TX_7: {
+		struct snd_soc_dai *codec_dai;
+		unsigned int mask = GENMASK(SC8280XP_TDM_SLOTS - 1, 0);
+		int i;
+
+		/* I2S style framing (Philips), as expected by smart amps */
+		snd_soc_dai_set_fmt(cpu_dai, SND_SOC_DAIFMT_BP_FP |
+				    SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF);
+		snd_soc_dai_set_tdm_slot(cpu_dai, mask, mask, SC8280XP_TDM_SLOTS,
+					 SC8280XP_TDM_SLOT_WIDTH);
+		for_each_rtd_codec_dais(rtd, i, codec_dai)
+			snd_soc_dai_set_fmt(codec_dai, SND_SOC_DAIFMT_BC_FC |
+					    SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF);
+		return 0;
+	}
 	case WSA_CODEC_DMA_RX_0:
 	case WSA_CODEC_DMA_RX_1:
 		/*
@@ -84,6 +107,7 @@ static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 	switch (cpu_dai->id) {
 	case PRIMARY_MI2S_RX...QUATERNARY_MI2S_TX:
 	case QUINARY_MI2S_RX...QUINARY_MI2S_TX:
+	case PRIMARY_TDM_RX_0...QUINARY_TDM_TX_7:
 		/* Smart amps such as AW88261 expect 32-bit slots (BCLK = 64 * fs) */
 		snd_mask_none(fmt);
 		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S32_LE);
@@ -120,9 +144,52 @@ static int sc8280xp_snd_hw_free(struct snd_pcm_substream *substream)
 	return qcom_snd_sdw_hw_free(substream, &data->stream_prepared[cpu_dai->id]);
 }
 
+static bool sc8280xp_is_tdm(struct snd_soc_dai *cpu_dai)
+{
+	return cpu_dai->id >= PRIMARY_TDM_RX_0 && cpu_dai->id <= QUINARY_TDM_TX_7;
+}
+
+static int sc8280xp_snd_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
+	int ret;
+
+	if (sc8280xp_is_tdm(cpu_dai)) {
+		ret = clk_prepare_enable(data->tdm_vote);
+		if (ret)
+			return ret;
+
+		ret = clk_set_rate(data->tdm_bclk, SC8280XP_TDM_BCLK_RATE);
+		if (!ret)
+			ret = clk_prepare_enable(data->tdm_bclk);
+		if (ret) {
+			clk_disable_unprepare(data->tdm_vote);
+			return ret;
+		}
+	}
+
+	return qcom_snd_sdw_startup(substream);
+}
+
+static void sc8280xp_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct sc8280xp_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
+
+	qcom_snd_sdw_shutdown(substream);
+
+	if (sc8280xp_is_tdm(cpu_dai)) {
+		clk_disable_unprepare(data->tdm_bclk);
+		clk_disable_unprepare(data->tdm_vote);
+	}
+}
+
 static const struct snd_soc_ops sc8280xp_be_ops = {
-	.startup = qcom_snd_sdw_startup,
-	.shutdown = qcom_snd_sdw_shutdown,
+	.startup = sc8280xp_snd_startup,
+	.shutdown = sc8280xp_snd_shutdown,
 	.hw_free = sc8280xp_snd_hw_free,
 	.prepare = sc8280xp_snd_prepare,
 };
@@ -157,6 +224,14 @@ static int sc8280xp_platform_probe(struct platform_device *pdev)
 	if (!data)
 		return -ENOMEM;
 
+	data->tdm_vote = devm_clk_get_optional(dev, "tdm-vote");
+	if (IS_ERR(data->tdm_vote))
+		return dev_err_probe(dev, PTR_ERR(data->tdm_vote), "failed to get tdm-vote clock\n");
+
+	data->tdm_bclk = devm_clk_get_optional(dev, "tdm-bclk");
+	if (IS_ERR(data->tdm_bclk))
+		return dev_err_probe(dev, PTR_ERR(data->tdm_bclk), "failed to get tdm-bclk clock\n");
+
 	card->dev = dev;
 	dev_set_drvdata(dev, card);
 	snd_soc_card_set_drvdata(card, data);
