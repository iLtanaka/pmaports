From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Sat, 3 Oct 2026 02:44:03 +0800
Subject: [PATCH] ASoC: qcom: audioreach: add TDM sink/source modules

Configure MODULE_ID_TDM_SINK/SOURCE with PARAM_ID_TDM_INTF_CFG (slots
and frame sync from the DAI, defaults derived from the stream), an
optional PARAM_ID_TDM_LANE_CFG (lane mask from the sd line token) and
the usual hw endpoint media format.

---
 sound/soc/qcom/qdsp6/audioreach.c | 126 ++++++++++++++++++++++++++++++
 sound/soc/qcom/qdsp6/audioreach.h |  40 ++++++++++
 sound/soc/qcom/qdsp6/topology.c   |   3 +
 3 files changed, 169 insertions(+)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index e6e9eb2e85..c5fbee548f 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -152,6 +152,20 @@ struct apm_i2s_module_intf_cfg {
 
 #define APM_I2S_INTF_CFG_PSIZE ALIGN(sizeof(struct apm_i2s_module_intf_cfg), 8)
 
+struct apm_tdm_module_intf_cfg {
+	struct apm_module_param_data param_data;
+	struct param_id_tdm_intf_cfg cfg;
+} __packed;
+
+#define APM_TDM_INTF_CFG_PSIZE ALIGN(sizeof(struct apm_tdm_module_intf_cfg), 8)
+
+struct apm_tdm_module_lane_cfg {
+	struct apm_module_param_data param_data;
+	struct param_id_tdm_lane_cfg cfg;
+} __packed;
+
+#define APM_TDM_LANE_CFG_PSIZE ALIGN(sizeof(struct apm_tdm_module_lane_cfg), 8)
+
 struct apm_module_hw_ep_mf_cfg {
 	struct apm_module_param_data param_data;
 	struct param_id_hw_ep_mf mf;
@@ -1042,6 +1056,114 @@ static int audioreach_i2s_set_media_format(struct q6apm_graph *graph,
 	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
 }
 
+static int audioreach_tdm_set_media_format(struct q6apm_graph *graph,
+					   const struct audioreach_module *module,
+					   const struct audioreach_module_config *cfg)
+{
+	struct apm_module_frame_size_factor_cfg *fs_cfg;
+	struct apm_module_param_data *param_data;
+	struct apm_tdm_module_intf_cfg *intf_cfg;
+	struct apm_tdm_module_lane_cfg *lane_cfg;
+	struct apm_module_hw_ep_mf_cfg *hw_cfg;
+	int ic_sz = APM_TDM_INTF_CFG_PSIZE;
+	/* For TDM modules the topology "sd line" token carries the lane mask */
+	int lc_sz = module->sd_line_idx ? APM_TDM_LANE_CFG_PSIZE : 0;
+	int ep_sz = APM_HW_EP_CFG_PSIZE;
+	int fs_sz = APM_FS_CFG_PSIZE;
+	int size = ic_sz + lc_sz + ep_sz + fs_sz;
+	u16 nslots = cfg->tdm_nslots ? cfg->tdm_nslots : cfg->num_channels;
+	u16 slot_width = cfg->tdm_slot_width ? cfg->tdm_slot_width : cfg->bit_width;
+	void *p;
+
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	p = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	intf_cfg = p;
+
+	param_data = &intf_cfg->param_data;
+	param_data->module_instance_id = module->instance_id;
+	param_data->error_code = 0;
+	param_data->param_id = PARAM_ID_TDM_INTF_CFG;
+	param_data->param_size = ic_sz - APM_MODULE_PARAM_DATA_SIZE;
+
+	intf_cfg->cfg.lpaif_type = module->hw_interface_type;
+	intf_cfg->cfg.intf_idx = module->hw_interface_idx;
+	intf_cfg->cfg.ctrl_data_out_enable = TDM_CTRL_DATA_OE_DISABLE;
+	intf_cfg->cfg.nslots_per_frame = nslots;
+	intf_cfg->cfg.slot_width = slot_width;
+	intf_cfg->cfg.slot_mask = cfg->tdm_slot_mask ? cfg->tdm_slot_mask :
+				  GENMASK(cfg->num_channels - 1, 0);
+
+	switch (cfg->fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_BC_FC:
+		intf_cfg->cfg.sync_src = TDM_SYNC_SRC_EXTERNAL;
+		break;
+	case SND_SOC_DAIFMT_BP_FP:
+	default:
+		intf_cfg->cfg.sync_src = TDM_SYNC_SRC_INTERNAL;
+		break;
+	}
+
+	switch (cfg->fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_DSP_A:
+		intf_cfg->cfg.sync_mode = TDM_SHORT_SYNC_BIT_MODE;
+		intf_cfg->cfg.ctrl_sync_data_delay = TDM_DATA_DELAY_1_BCLK_CYCLE;
+		break;
+	case SND_SOC_DAIFMT_DSP_B:
+		intf_cfg->cfg.sync_mode = TDM_SHORT_SYNC_BIT_MODE;
+		intf_cfg->cfg.ctrl_sync_data_delay = TDM_DATA_DELAY_0_BCLK_CYCLE;
+		break;
+	case SND_SOC_DAIFMT_I2S:
+	default:
+		/* I2S framing: 50% duty frame sync, low for the first slot */
+		intf_cfg->cfg.sync_mode = TDM_LONG_SYNC_MODE;
+		intf_cfg->cfg.ctrl_invert_sync_pulse = TDM_SYNC_INVERT;
+		intf_cfg->cfg.ctrl_sync_data_delay = TDM_DATA_DELAY_1_BCLK_CYCLE;
+		break;
+	}
+
+	if ((cfg->fmt & SND_SOC_DAIFMT_INV_MASK) == SND_SOC_DAIFMT_NB_IF ||
+	    (cfg->fmt & SND_SOC_DAIFMT_INV_MASK) == SND_SOC_DAIFMT_IB_IF)
+		intf_cfg->cfg.ctrl_invert_sync_pulse ^= TDM_SYNC_INVERT;
+
+	p += ic_sz;
+	if (lc_sz) {
+		lane_cfg = p;
+		param_data = &lane_cfg->param_data;
+		param_data->module_instance_id = module->instance_id;
+		param_data->error_code = 0;
+		param_data->param_id = PARAM_ID_TDM_LANE_CFG;
+		param_data->param_size = lc_sz - APM_MODULE_PARAM_DATA_SIZE;
+		lane_cfg->cfg.lane_mask = module->sd_line_idx;
+		p += lc_sz;
+	}
+
+	hw_cfg = p;
+	param_data = &hw_cfg->param_data;
+	param_data->module_instance_id = module->instance_id;
+	param_data->error_code = 0;
+	param_data->param_id = PARAM_ID_HW_EP_MF_CFG;
+	param_data->param_size = ep_sz - APM_MODULE_PARAM_DATA_SIZE;
+
+	hw_cfg->mf.sample_rate = cfg->sample_rate;
+	hw_cfg->mf.bit_width = cfg->bit_width;
+	hw_cfg->mf.num_channels = cfg->num_channels;
+	hw_cfg->mf.data_format = module->data_format;
+
+	p += ep_sz;
+	fs_cfg = p;
+	param_data = &fs_cfg->param_data;
+	param_data->module_instance_id = module->instance_id;
+	param_data->error_code = 0;
+	param_data->param_id = PARAM_ID_HW_EP_FRAME_SIZE_FACTOR;
+	param_data->param_size = fs_sz - APM_MODULE_PARAM_DATA_SIZE;
+	fs_cfg->frame_size_factor = 1;
+
+	return q6apm_send_cmd_sync(graph->apm, pkt, 0);
+}
+
 static int audioreach_logging_set_media_format(struct q6apm_graph *graph,
 					       const struct audioreach_module *module)
 {
@@ -1377,6 +1499,10 @@ int audioreach_set_media_format(struct q6apm_graph *graph,
 	case MODULE_ID_I2S_SINK:
 		rc = audioreach_i2s_set_media_format(graph, module, cfg);
 		break;
+	case MODULE_ID_TDM_SOURCE:
+	case MODULE_ID_TDM_SINK:
+		rc = audioreach_tdm_set_media_format(graph, module, cfg);
+		break;
 	case MODULE_ID_WR_SHARED_MEM_EP:
 	case MODULE_ID_SH_MEM_PULL_MODE:
 		rc = audioreach_shmem_set_media_format(graph, module, cfg);
diff --git a/sound/soc/qcom/qdsp6/audioreach.h b/sound/soc/qcom/qdsp6/audioreach.h
index 62a2fd79bb..739049aada 100644
--- a/sound/soc/qcom/qdsp6/audioreach.h
+++ b/sound/soc/qcom/qdsp6/audioreach.h
@@ -22,6 +22,8 @@ struct q6apm_graph;
 #define MODULE_ID_PLACEHOLDER_DECODER	0x07001009
 #define MODULE_ID_I2S_SINK		0x0700100A
 #define MODULE_ID_I2S_SOURCE		0x0700100B
+#define MODULE_ID_TDM_SINK		0x0700100E
+#define MODULE_ID_TDM_SOURCE		0x0700100F
 #define MODULE_ID_SAL			0x07001010
 #define MODULE_ID_MFC			0x07001015
 #define MODULE_ID_DATA_LOGGING		0x0700101A
@@ -530,6 +532,40 @@ struct param_id_i2s_intf_cfg {
 	uint16_t ws_src;
 } __packed;
 
+#define PARAM_ID_TDM_INTF_CFG			0x0800101B
+struct param_id_tdm_intf_cfg {
+	uint32_t lpaif_type;
+	uint32_t intf_idx;
+	uint16_t sync_src;
+	uint16_t ctrl_data_out_enable;
+	uint32_t slot_mask;
+	uint16_t nslots_per_frame;
+	uint16_t slot_width;
+	uint16_t sync_mode;
+	uint16_t ctrl_invert_sync_pulse;
+	uint16_t ctrl_sync_data_delay;
+	uint16_t reserved;
+} __packed;
+
+#define TDM_SYNC_SRC_EXTERNAL		0x0
+#define TDM_SYNC_SRC_INTERNAL		0x1
+#define TDM_CTRL_DATA_OE_DISABLE	0x0
+#define TDM_CTRL_DATA_OE_ENABLE		0x1
+#define TDM_SHORT_SYNC_BIT_MODE		0
+#define TDM_LONG_SYNC_MODE		1
+#define TDM_SHORT_SYNC_SLOT_MODE	2
+#define TDM_SYNC_NORMAL			0
+#define TDM_SYNC_INVERT			1
+#define TDM_DATA_DELAY_0_BCLK_CYCLE	0
+#define TDM_DATA_DELAY_1_BCLK_CYCLE	1
+#define TDM_DATA_DELAY_2_BCLK_CYCLE	2
+
+#define PARAM_ID_TDM_LANE_CFG			0x0800106A
+struct param_id_tdm_lane_cfg {
+	uint16_t lane_mask;
+	uint16_t reserved;
+} __packed;
+
 #define I2S_INTF_TYPE_PRIMARY		0
 #define I2S_INTF_TYPE_SECONDARY		1
 #define I2S_INTF_TYPE_TERTIARY		2
@@ -907,6 +943,10 @@ struct audioreach_module_config {
 	u32	channel_allocation;
 	u32	sd_line_mask;
 	int	fmt;
+	/* TDM: slot_mask/nslots/slot_width of 0 means derive from the stream */
+	u32	tdm_slot_mask;
+	u16	tdm_nslots;
+	u16	tdm_slot_width;
 	struct snd_codec codec;
 	u8 channel_map[AR_PCM_MAX_NUM_CHANNEL];
 };
diff --git a/sound/soc/qcom/qdsp6/topology.c b/sound/soc/qcom/qdsp6/topology.c
index 1f69fba6de..11992166ce 100644
--- a/sound/soc/qcom/qdsp6/topology.c
+++ b/sound/soc/qcom/qdsp6/topology.c
@@ -804,6 +804,9 @@ static int audioreach_widget_load_buffer(struct snd_soc_component *component,
 		break;
 	case MODULE_ID_I2S_SINK:
 	case MODULE_ID_I2S_SOURCE:
+	/* Same tokens: interface type/index, data format, sd line (lane mask) */
+	case MODULE_ID_TDM_SINK:
+	case MODULE_ID_TDM_SOURCE:
 		audioreach_widget_i2s_module_load(mod, mod_array);
 		break;
 	case MODULE_ID_DISPLAY_PORT_SINK:
