builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make -j$(nproc) ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS" \
		Image modules qcom/sm8475-xiaomi-marble.dtb
}

package() {
	mkdir -p "$pkgdir"/boot

	DEPMOD=/bin/true make -j$(nproc) modules_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -Dm644 "$builddir/arch/$_carch/boot/dts/qcom/sm8475-xiaomi-marble.dtb" \
		"$pkgdir/boot/dtbs/qcom/sm8475-xiaomi-marble.dtb"

	if [ -e "$builddir/arch/$_carch/boot/Image.gz" ]; then
		install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
			"$pkgdir/boot/vmlinuz"
	else
		gzip -c "$builddir/arch/$_carch/boot/Image" > "$pkgdir/boot/vmlinuz"
	fi

	install -Dm644 "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

