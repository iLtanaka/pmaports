 drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c    |  73 ++++++
 drivers/iommu/arm/arm-smmu/arm-smmu.h         |   1 +
 drivers/media/platform/qcom/iris/Makefile     |   3 +-
