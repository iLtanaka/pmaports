From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Fri, 2 Oct 2026 14:15:39 +0800
Subject: [PATCH] 0007-drm-msm-dsi-support-dsc-slice-per-pkt

---
 drivers/gpu/drm/msm/dsi/dsi_host.c                 | 13 +++++--------
 drivers/gpu/drm/panel/panel-xiaomi-m16t-36-02-0a.c |  3 ++-
 include/drm/drm_mipi_dsi.h                         |  1 +
 3 files changed, 8 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index d3adb6be19..b05cf24a00 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -166,6 +166,7 @@ struct msm_dsi_host {
 
 	struct drm_display_mode *mode;
 	struct drm_dsc_config *dsc;
+	unsigned int dsc_slice_per_pkt;
 
 	/* connected device info */
 	unsigned int channel;
@@ -952,17 +953,12 @@ static void dsi_update_dsc_timing(struct msm_dsi_host *msm_host, bool is_cmd_mod
 	slice_per_intf = dsc->slice_count;
 
 	total_bytes_per_intf = dsc->slice_chunk_size * slice_per_intf;
-	bytes_per_pkt = dsc->slice_chunk_size; /* * slice_per_pkt; */
+	bytes_per_pkt = dsc->slice_chunk_size * msm_host->dsc_slice_per_pkt;
 
 	eol_byte_num = total_bytes_per_intf % 3;
 
-	/*
-	 * Typically, pkt_per_line = slice_per_intf * slice_per_pkt.
-	 *
-	 * Since the current driver only supports slice_per_pkt = 1,
-	 * pkt_per_line will be equal to slice per intf for now.
-	 */
-	pkt_per_line = slice_per_intf;
+	/* e.g. 2 slices/line sent as 1 packet of 2 slices (marble panel) */
+	pkt_per_line = slice_per_intf / msm_host->dsc_slice_per_pkt;
 
 	if (is_cmd_mode) /* packet data type */
 		reg = DSI_COMMAND_COMPRESSION_MODE_CTRL_STREAM0_DATATYPE(MIPI_DSI_DCS_LONG_WRITE);
@@ -1738,6 +1734,7 @@ static int dsi_host_attach(struct mipi_dsi_host *host,
 	msm_host->mode_flags = dsi->mode_flags;
 	if (dsi->dsc)
 		msm_host->dsc = dsi->dsc;
+	msm_host->dsc_slice_per_pkt = dsi->dsc_slice_per_pkt ?: 1;
 
 	if (msm_host->format == MIPI_DSI_FMT_RGB101010) {
 		if (!msm_dsi_host_version_geq(msm_host, MSM_DSI_VER_MAJOR_6G,
diff --git a/drivers/gpu/drm/panel/panel-xiaomi-m16t-36-02-0a.c b/drivers/gpu/drm/panel/panel-xiaomi-m16t-36-02-0a.c
index 90f0a82c89..d8419959d2 100644
--- a/drivers/gpu/drm/panel/panel-xiaomi-m16t-36-02-0a.c
+++ b/drivers/gpu/drm/panel/panel-xiaomi-m16t-36-02-0a.c
@@ -359,7 +359,8 @@ static int xiaomi_m16t_probe(struct mipi_dsi_device *dsi)
 	ctx->dsc.dsc_version_major = 1;
 	ctx->dsc.dsc_version_minor = 2;
 
-	/* TODO: Pass slice_per_pkt = 2 */
+	/* stock qcom,mdss-dsc-slice-per-pkt = <2>: one packet per line */
+	dsi->dsc_slice_per_pkt = 2;
 	ctx->dsc.slice_height = 20;
 	ctx->dsc.slice_width = 540;
 	/*
diff --git a/include/drm/drm_mipi_dsi.h b/include/drm/drm_mipi_dsi.h
index b429acde4f..0754945070 100644
--- a/include/drm/drm_mipi_dsi.h
+++ b/include/drm/drm_mipi_dsi.h
@@ -195,6 +195,7 @@ struct mipi_dsi_device {
 	unsigned long hs_rate;
 	unsigned long lp_rate;
 	struct drm_dsc_config *dsc;
+	unsigned int dsc_slice_per_pkt;
 };
 
