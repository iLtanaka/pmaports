From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>
Date: Thu, 8 Oct 2026 11:18:04 +0800
Subject: [PATCH] arm64: dts: qcom: sm8475-xiaomi-marble: describe the battery

The ADSP battery firmware does not report a design voltage, so UPower
falls back to 10 V when converting charge to energy. Add a simple-battery
node for the 5000 mAh BP4K/M16T cell (3.87 V rated) and reference it from
pmic-glink.

---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
index b7cb19809d..35aea3078a 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-marble.dts
@@ -35,10 +35,22 @@ / {
 	 * Battery/charger run in ADSP firmware (battmgr) over pmic_glink. No
 	 * usb-c-connector yet: usb_1_dwc3 stays dr_mode=peripheral for netboot.
 	 */
+	/*
+	 * BP4K / M16T 5000 mAh cell. The ADSP does not report a design
+	 * voltage; UPower needs one to turn charge into energy (it assumes
+	 * 10 V otherwise). The rated 3.87 V (19.35 Wh) is used here.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		charge-full-design-microamp-hours = <5000000>;
+		voltage-min-design-microvolt = <3870000>;
+	};
+
 	pmic-glink {
 		compatible = "qcom,sm8475-pmic-glink", "qcom,sm8450-pmic-glink", "qcom,pmic-glink";
 		#address-cells = <1>;
 		#size-cells = <0>;
+		monitored-battery = <&battery>;
 	};
 
 	/* QCA6490 (WCN6855 family, PCI 17cb:1103) wired as on sm8450-hdk */
