# Reference: <https://postmarketos.org/devicepkg>
maintainer="Tatsuki Tanaka <tatsuki@tanakatatsuki.dev>"
pkgname=device-xiaomi-marble
pkgdesc="Xiaomi POCO F5 / Redmi Note 12 Turbo"
pkgver=1
pkgrel=41
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	hexagonrpcd
	linux-xiaomi-marble
	postmarketos-base
	rmtfs
	soc-qcom
"
makedepends="devicepkg-dev gcc musl-dev linux-headers"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
source="
	50-marble-display-on.sh
	81-libssc-xiaomi-marble.rules
	alsa-ucm-conf/HiFi.conf
	alsa-ucm-conf/marble.conf
	deviceinfo
	environment-marble.conf
	hexagonrpcd-sdsp-marble.conf
	iio-sensor-proxy-marble.conf
	plasma-mobile-marble.conf
	modules-load.conf
	modules-initfs
	marble-hardware-tuning.sh
	marble-hardware-tuning.service
	60-marble-storage.rules
	61-marble-gpu.rules
	99-marble-vm.conf
	marble-kwin-boost.sh
	marble-touchboost.c
	marble-touchboost.service
	plasma-kwin_wayland-marble.conf
"

build() {
	devicepkg_build $startdir $pkgname
	${CC:-gcc} $CFLAGS -Wall -Wextra $LDFLAGS -o marble-touchboost "$srcdir"/marble-touchboost.c
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/50-marble-display-on.sh \
		"$pkgdir"/usr/share/mkinitfs/hooks/50-marble-display-on.sh
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8450/xiaomi-marble/HiFi.conf
	install -Dm644 "$srcdir"/marble.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8450/SM8475-Xiaomi-Marble.conf
	install -Dm644 "$srcdir"/81-libssc-xiaomi-marble.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-xiaomi-marble.rules
	install -Dm644 "$srcdir"/hexagonrpcd-sdsp-marble.conf \
		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d/50-marble.conf
	install -Dm644 "$srcdir"/iio-sensor-proxy-marble.conf \
		"$pkgdir"/usr/lib/systemd/system/iio-sensor-proxy.service.d/50-marble.conf
	install -Dm644 "$srcdir"/plasma-mobile-marble.conf \
		"$pkgdir"/usr/lib/systemd/system/plasma-mobile.service.d/50-marble-sensors.conf
	install -Dm644 "$srcdir"/environment-marble.conf \
		"$pkgdir"/usr/lib/environment.d/90-xiaomi-marble.conf
	install -Dm755 "$srcdir"/marble-hardware-tuning.sh \
		"$pkgdir"/usr/libexec/marble-hardware-tuning.sh
	install -Dm644 "$srcdir"/marble-hardware-tuning.service \
		"$pkgdir"/usr/lib/systemd/system/marble-hardware-tuning.service
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../marble-hardware-tuning.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/marble-hardware-tuning.service
	install -Dm644 "$srcdir"/60-marble-storage.rules \
		"$pkgdir"/usr/lib/udev/rules.d/60-marble-storage.rules
	install -Dm644 "$srcdir"/61-marble-gpu.rules \
		"$pkgdir"/usr/lib/udev/rules.d/61-marble-gpu.rules
	install -Dm755 "$srcdir"/marble-kwin-boost.sh \
		"$pkgdir"/usr/libexec/marble-kwin-boost.sh
	install -Dm644 "$srcdir"/plasma-kwin_wayland-marble.conf \
		"$pkgdir"/usr/lib/systemd/user/plasma-kwin_wayland.service.d/50-marble-boost.conf
	install -Dm755 marble-touchboost \
		"$pkgdir"/usr/libexec/marble-touchboost
	install -Dm644 "$srcdir"/marble-touchboost.service \
		"$pkgdir"/usr/lib/systemd/system/marble-touchboost.service
	ln -s ../marble-touchboost.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/marble-touchboost.service
	install -Dm644 "$srcdir"/99-marble-vm.conf \
		"$pkgdir"/usr/lib/sysctl.d/99-marble-vm.conf
}

nonfree_firmware() {
	pkgdesc="Firmware for GPU, modem, Wi-Fi, Bluetooth, audio, sensors and video"
	depends="
		firmware-xiaomi-marble-adreno
		firmware-xiaomi-marble-adsp
		firmware-xiaomi-marble-audio
		firmware-xiaomi-marble-bluetooth
		firmware-xiaomi-marble-hexagonfs
		firmware-xiaomi-marble-modem
		firmware-xiaomi-marble-slpi
		firmware-xiaomi-marble-venus
		firmware-xiaomi-marble-wlan
		"
	mkdir "$subpkgdir"
}

# pkgrel 31: Add marble-hardware-tuning, UFS scheduler none, and VM dirty limits.
# pkgrel 32: marble-hardware-tuning only sets IRQ affinities (UFS/CPU/GPU frequency
# floors dropped: idle battery cost, no measurable gain); enable it by default.
# pkgrel 33: deviceinfo_flash_kernel_on_update=false (no slot suffix in /proc/cmdline;
# boot_b/vendor_boot_b are flashed with fastboot from the PC).
# pkgrel 34: UI responsiveness: GPU devfreq floor 324 MHz (udev) and a uclamp.min
# frequency floor for KWin (user unit drop-in) instead of a global performance governor.
# GPU runtime autosuspend delay 66 -> 500 ms (wake-up after short idle stalled frames 45-90 ms).
# pkgrel 35: marble-touchboost: raise CPU floors while touching (UI trailed the finger at idle clocks;
# SM8450 mainline DT has no CPU->L3/DDR bandwidth scaling yet).
# pkgrel 36: release cleanup: boot-deploy generates extlinux.conf for U-Boot; ship UCM,
# libssc mount matrix, haptics/display module loading and the GTK redraw workaround;
# add the nonfree-firmware subpackage; drop the initramfs debug-shell and autolog hook
# and the super partition lookup (rootfs is a normal partition).
# pkgrel 37: initramfs hook cycles the display off/on so the FDE unlock screen (unl0kr)
# is visible; the panel stays dark after the first enable at boot.
# pkgrel 38: depend on rmtfs (the modem does not boot without it); start hexagonrpcd-sdsp
# when the SLPI node appears and restart iio-sensor-proxy after it; UCM routes the capture
# front end in the verb so PulseAudio can probe the microphone.
# pkgrel 39: replace the hexagonrpcd udev/restart hack (ExecStartPost ran as the fastrpc
# user and looped) with unit ordering: hexagonrpcd waits for the SLPI node, iio-sensor-proxy
# starts after it. pkgrel 40: hexagonrpcd needs ~10 s before the sensors are served.
# pkgrel 41: start the Plasma Mobile session only once iio-sensor-proxy reports the sensors
# (KWin/powerdevil check once at startup; auto-rotate and auto-brightness never saw them).
